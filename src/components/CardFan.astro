---
interface Card {
	label: string;
	href: string;
}

interface Props {
	cards: Card[];
}

const { cards } = Astro.props;

// Alternate slight fan rotation so it reads as a hand of cards, not a rigid grid.
const angles = [-8, -4, 0, 4, 8, 12, -12];
---

<div class="card-fan">
	{cards.map((card, i) => (
		<a
			class="fan-card"
			href={card.href}
			style={`--rotate: ${angles[i % angles.length]}deg;`}
		>
			<span class="corner">♠</span>
			<span class="label">{card.label}</span>
			<span class="corner corner-bottom">♠</span>
		</a>
	))}
</div>

<style>
	.card-fan {
		display: flex;
		justify-content: center;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 0;
		padding: 2rem 0 3rem;
	}

	.fan-card {
		--rotate: 0deg;
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: 140px;
		height: 200px;
		margin: 0 -14px;
		padding: 0.85rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
		text-decoration: none;
		color: inherit;
		transform: rotate(var(--rotate));
		transform-origin: bottom center;
		transition: transform 0.2s ease, box-shadow 0.2s ease, z-index 0.2s ease;
	}

	.fan-card:hover,
	.fan-card:focus-visible {
		transform: rotate(var(--rotate)) translateY(-18px) scale(1.04);
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.16);
		z-index: 10;
	}

	.corner {
		font-size: 1.1rem;
		opacity: 0.5;
		line-height: 1;
	}

	.corner-bottom {
		align-self: flex-end;
		transform: rotate(180deg);
	}

	.label {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: 1rem;
		font-weight: 600;
		padding: 0 0.25rem;
	}

	@media (max-width: 640px) {
		.fan-card {
			width: 110px;
			height: 160px;
			margin: 0 -10px;
		}
	}
</style>
