---
const nav = [
	{ href: '/work', label: 'Work' },
	{ href: '/case-competitions', label: 'Case Competitions' },
	{ href: '/mocks', label: 'Mocks' },
	{ href: '/about', label: 'About' },
];

// TODO: replace with the real Drive permalink once the resume is uploaded.
const resumeUrl = 'https://drive.google.com/file/d/REPLACE_WITH_FILE_ID/view';

interface Props {
	// Float over a dark full-bleed hero instead of sitting in the page flow.
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]}>
	<a class="brand" href="/">Shubhangi Goyal</a>
	<nav>
		{nav.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
		<a class="resume-link" href={resumeUrl} target="_blank" rel="noopener noreferrer">
			Resume
		</a>
		<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
			<span class="icon icon-sun">☀</span>
			<span class="icon icon-moon">☾</span>
		</button>
	</nav>
</header>

<script is:inline>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});
</script>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5rem 2rem;
		max-width: 960px;
		margin: 0 auto;
	}
	/* Sits on top of the hero image; always light text since the hero is dark
	   in both themes. */
	.site-header.overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		max-width: none;
		padding: 1.5rem clamp(1.25rem, 4vw, 3rem);
		color: #f5f1ea;
	}
	.site-header.overlay #theme-toggle {
		border-color: rgba(245, 241, 234, 0.4);
	}
	.brand {
		font-weight: 600;
		text-decoration: none;
		color: inherit;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	nav a {
		text-decoration: none;
		color: inherit;
	}
	.resume-link {
		border: 1px solid currentColor;
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
		font-size: 0.9rem;
	}
	#theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: none;
		color: inherit;
		cursor: pointer;
		padding: 0;
		font-size: 0.95rem;
		line-height: 1;
	}
	.icon-moon {
		display: none;
	}
	:root[data-theme='dark'] .icon-sun {
		display: none;
	}
	:root[data-theme='dark'] .icon-moon {
		display: inline;
	}
</style>
