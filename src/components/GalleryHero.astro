---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero.jpg';

interface Props {
	headline: string;
	subhead: string;
	name: string;
	roles: string[];
}

const { headline, subhead, name, roles } = Astro.props;
---

<section class="hero-scroll">
	<div class="hero">
		<div class="hero-text">
			<p class="eyebrow">by {name}</p>
			<h1>{headline}</h1>
			<p class="subhead">{subhead}</p>
			<p class="roles">{roles.join(' / ')}</p>

			<a class="scroll-cue" href="#museum">
				<span>enter the collection</span>
				<span class="arrow" aria-hidden="true">↓</span>
			</a>
		</div>

		<div class="hero-photo">
			<Image src={heroPhoto} alt={name} width={900} height={1125} loading="eager" fetchpriority="high" />
		</div>
	</div>
</section>

<style>
	.hero-scroll {
		/* One extra viewport of scroll so the pinned hero has room to fade/slide
		   away before the carousel below takes over. */
		height: 200svh;
		position: relative;
		view-timeline-name: --hero-exit;
		view-timeline-axis: block;
	}

	.hero {
		position: sticky;
		top: 0;
		height: 100svh;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		background: #14100c;
		color: #f7f3ec;
		overflow: hidden;
	}

	.hero-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		text-align: left;
		gap: 1rem;
		padding: 2rem clamp(1.5rem, 6vw, 5rem);
		animation: text-fade linear both;
		animation-timeline: --hero-exit;
		animation-range: cover 0% cover 55%;
	}

	.hero-photo {
		height: 100%;
		animation: photo-fade linear both;
		animation-timeline: --hero-exit;
		animation-range: cover 0% cover 55%;
	}

	.hero-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}

	@keyframes text-fade {
		to {
			opacity: 0;
			transform: translateY(-2.5rem);
		}
	}

	@keyframes photo-fade {
		to {
			opacity: 0;
			transform: translateX(6%) scale(0.94);
		}
	}

	.eyebrow {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(2.5rem, 6.5vw, 5rem);
		line-height: 1.02;
	}

	.subhead {
		margin: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-size: clamp(1.1rem, 2.2vw, 1.5rem);
		max-width: 28rem;
		opacity: 0.9;
	}

	.roles {
		margin: 0.25rem 0 0;
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	.scroll-cue {
		margin-top: 1.5rem;
		padding: 0.7rem 0 1.1rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		opacity: 0.65;
		transition: opacity 0.2s ease;
	}

	.scroll-cue:hover,
	.scroll-cue:focus-visible {
		opacity: 1;
	}

	.arrow {
		animation: nudge 2s ease-in-out infinite;
	}

	@keyframes nudge {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(4px);
		}
	}

	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
		}
		.hero-photo {
			height: 40svh;
		}
		.hero-text {
			text-align: center;
			align-items: center;
		}
	}

	/* No scroll-timeline support: keep the hero static instead of relying on
	   the pinned fade, matching the Museum fallback below. */
	@supports not (animation-timeline: view()) {
		.hero-scroll {
			height: auto;
		}
		.hero {
			position: static;
			height: 100svh;
		}
		.hero-text,
		.hero-photo {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow {
			animation: none;
		}
		.hero-scroll {
			height: auto;
		}
		.hero {
			position: static;
			height: 100svh;
		}
		.hero-text,
		.hero-photo {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
