---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Stat {
	value: string;
	label: string;
}

type Layout = 'text-only' | 'image-left' | 'image-right' | 'image-top';

interface Room {
	eyebrow: string;
	label: string;
	caption: string;
	href: string;
	stat?: Stat;
	image?: ImageMetadata;
	imageAlt?: string;
	layout?: Layout;
}

interface Props {
	rooms: Room[];
}

const { rooms } = Astro.props;

// The corridor is a single continuous camera dolly (translateZ on .world)
// driven by scroll. Each artwork sits at a fixed depth/side in 3D space;
// the dolly moving forward is what makes them appear to approach and pass.
const STEP = 62; // vw of depth between consecutive artworks
const BUFFER = 0.6; // empty run-up/run-out depth so the walk has room to start/end
const totalDepth = (rooms.length + BUFFER) * STEP;

const tiles = rooms.map((room, i) => {
	const depth = (i + 1) * STEP;
	const side = i % 2 === 0 ? -1 : 1;
	const arrival = (depth / totalDepth) * 100;
	const half = ((STEP / totalDepth) * 100) / 2;
	const start = Math.max(0, arrival - half * 1.4);
	const end = Math.min(100, arrival + half * 1.1);
	return { room, depth, side, start, end };
});
---

<section class="corridor" id="museum" style={`--room-count: ${rooms.length};`}>
	<div class="viewport">
		<div class="world" style={`--total-depth: ${totalDepth};`}>
			{tiles.map(({ room, depth, side, start, end }, i) => (
				<a
					class="tile"
					href={room.href}
					style={`--depth: ${depth}; --side: ${side}; --start: ${start}%; --end: ${end}%;`}
				>
					<span class={`frame layout-${room.layout ?? 'text-only'}`}>
						{room.image && (
							<span class="frame-image">
								<Image src={room.image} alt={room.imageAlt ?? room.label} width={640} height={640} />
							</span>
						)}
						<span class="frame-body">
							<span class="frame-top">
								<span class="index">{String(i + 1).padStart(2, '0')}</span>
								<span class="eyebrow">{room.eyebrow}</span>
							</span>
							<h2>{room.label}</h2>
							<p>{room.caption}</p>
							{room.stat && (
								<span class="stat">
									<span class="stat-value">{room.stat.value}</span>
									<span class="stat-label">{room.stat.label}</span>
								</span>
							)}
							<span class="enter">Enter →</span>
						</span>
					</span>
				</a>
			))}
		</div>
		<div class="vignette" aria-hidden="true"></div>
	</div>

	<noscript>
		<div class="fallback-list">
			{rooms.map((room) => (
				<a href={room.href}>{room.label}</a>
			))}
		</div>
	</noscript>
</section>

<style>
	.corridor {
		/* One viewport of scroll per artwork, plus run-up/run-out room. */
		height: calc((var(--room-count, 4) + 1) * 100svh);
		position: relative;
		view-timeline-name: --corridor-walk;
		view-timeline-axis: block;
	}

	.viewport {
		position: sticky;
		top: 0;
		height: 100svh;
		overflow: hidden;
		background: #0f0c09;
		perspective: 1400px;
		perspective-origin: 50% 46%;
	}

	.world {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		animation-name: dolly;
		animation-timing-function: linear;
		animation-fill-mode: both;
		animation-timeline: --corridor-walk;
		animation-range: cover 0% cover 100%;
	}

	@keyframes dolly {
		to {
			transform: translateZ(calc(var(--total-depth) * 1vw));
		}
	}

	.tile {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(78vw, 30rem);
		text-decoration: none;
		color: inherit;
		transform: translate(-50%, -50%) translateZ(calc(var(--depth) * -1vw)) translateX(calc(var(--side) * 22vw))
			rotateY(calc(var(--side) * -24deg));
		backface-visibility: hidden;
		animation-name: tile-fade;
		animation-timing-function: linear;
		animation-fill-mode: both;
		animation-timeline: --corridor-walk;
		animation-range: var(--start) var(--end);
	}

	@keyframes tile-fade {
		0% {
			opacity: 0;
		}
		30%,
		75% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	.frame {
		display: grid;
		text-align: left;
		border: 14px solid var(--color-accent);
		background: var(--color-panel);
		color: var(--color-text);
		box-shadow: 0 40px 90px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
		transition: box-shadow 0.25s ease;
		overflow: hidden;
	}

	.tile:hover .frame,
	.tile:focus-visible .frame {
		box-shadow: 0 50px 110px rgba(0, 0, 0, 0.55), inset 0 0 0 1px rgba(0, 0, 0, 0.08);
	}

	.frame-body {
		padding: clamp(1.75rem, 4vw, 2.75rem);
	}

	.frame-image {
		display: block;
		line-height: 0;
	}

	.frame-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* text-only: default single-column, no image slot rendered */

	.layout-image-top {
		grid-template-rows: auto 1fr;
	}

	.layout-image-top .frame-image {
		aspect-ratio: 16 / 9;
	}

	.layout-image-left,
	.layout-image-right {
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
	}

	.layout-image-right {
		grid-template-columns: 1fr 1fr;
	}

	.layout-image-right .frame-image {
		order: 2;
	}

	.frame-top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.index {
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: var(--color-accent);
	}

	.eyebrow {
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.frame h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.5rem, 3.2vw, 2.25rem);
	}

	.frame p {
		margin: 0 0 1.25rem;
		color: var(--color-muted);
		line-height: 1.5;
	}

	.stat {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin: 0 0 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.stat-value {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		color: var(--color-accent);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--color-muted);
		max-width: 14rem;
	}

	.enter {
		display: inline-block;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(ellipse at 50% 46%, transparent 35%, #0f0c09 92%);
	}

	@media (max-width: 760px) {
		.tile {
			width: 84vw;
		}

		.layout-image-left,
		.layout-image-right {
			grid-template-columns: 1fr;
		}

		.layout-image-left .frame-image,
		.layout-image-right .frame-image {
			order: initial;
			aspect-ratio: 16 / 9;
		}
	}

	/* No scroll-timeline support (e.g. current Safari): stack the rooms as a
	   plain vertical list instead of relying on the sticky/3D corridor. */
	@supports not (animation-timeline: view()) {
		.corridor {
			height: auto;
		}
		.viewport {
			position: static;
			height: auto;
			perspective: none;
			display: flex;
			flex-direction: column;
			gap: 2rem;
			padding: 4rem 0;
			background: var(--color-bg);
		}
		.world {
			position: static;
			animation: none;
			display: contents;
		}
		.tile {
			position: static;
			transform: none;
			animation: none;
			opacity: 1;
		}
		.vignette {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.corridor {
			height: auto;
		}
		.viewport {
			position: static;
			height: auto;
			perspective: none;
			display: flex;
			flex-direction: column;
			gap: 2rem;
			padding: 4rem 0;
			background: var(--color-bg);
		}
		.world {
			position: static;
			animation: none;
			display: contents;
		}
		.tile {
			position: static;
			transform: none;
			animation: none;
			opacity: 1;
		}
		.vignette {
			display: none;
		}
	}

	.fallback-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 3rem 0;
	}
</style>
