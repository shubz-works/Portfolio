---
interface Panel {
	label: string;
	href: string;
	/* Short line under the label — the wall-label copy for that piece. */
	caption?: string;
}

interface Props {
	panels: Panel[];
}

const { panels } = Astro.props;
---

<div class="wall">
	{panels.map((panel) => (
		<a class="frame" href={panel.href}>
			<div class="mat">
				<h3 class="label">{panel.label}</h3>
				{panel.caption && <p class="caption">{panel.caption}</p>}
				<span class="enter">View →</span>
			</div>
		</a>
	))}
</div>

<style>
	.wall {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: clamp(1.25rem, 3vw, 2.5rem);
		padding: 1rem 0 2rem;
	}

	/* Thin gilt frame + matte board, echoing the framed panels in the hero. */
	.frame {
		display: block;
		padding: 0.5rem;
		background: var(--color-panel);
		border: 1px solid var(--color-accent);
		box-shadow: 0 6px 18px rgba(26, 23, 20, 0.12);
		text-decoration: none;
		color: inherit;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.frame:hover,
	.frame:focus-visible {
		transform: translateY(-6px);
		box-shadow: 0 16px 34px rgba(26, 23, 20, 0.2);
	}

	.mat {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		min-height: 12rem;
		padding: 1.75rem 1.5rem;
		border: 1px solid var(--color-border);
	}

	.label {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.6rem;
		line-height: 1.1;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0;
	}

	.caption {
		font-size: 0.9rem;
		color: var(--color-muted);
		line-height: 1.5;
		margin: 0;
	}

	.enter {
		margin-top: auto;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.frame {
			transition: none;
		}
		.frame:hover,
		.frame:focus-visible {
			transform: none;
		}
	}
</style>
