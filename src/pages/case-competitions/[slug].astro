---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const items = await getCollection('work', (entry) => entry.data.category === 'case-comp');
	return items.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Layout title={data.title} description={data.summary}>
	<p class="context">{data.context}</p>
	<h1>{data.title}</h1>
	<p class="summary">{data.summary}</p>

	<section class="problem">
		<Content />
	</section>

	{data.outcome && (
		<section class="outcome">
			<h2>Outcome</h2>
			<p>{data.outcome}</p>
		</section>
	)}

	<a class="back" href="/case-competitions">← Back to case competitions</a>
</Layout>

<style>
	.context {
		font-size: 0.85rem;
		text-transform: uppercase;
		opacity: 0.6;
		margin-bottom: 0.25rem;
	}
	.summary {
		font-size: 1.1rem;
		opacity: 0.85;
	}
	.back {
		display: inline-block;
		margin-top: 2rem;
		color: inherit;
	}
</style>
