---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const work = await getCollection('work');
const featured = work.filter((w) => w.data.featured).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Your Name">
	<section class="hero">
		<h1>Your Name</h1>
		<p>MBA @ IIM Kozhikode · ex-agency PR &amp; Marketing → General Management &amp; Brand roles</p>
	</section>

	<section class="featured">
		<h2>Featured work</h2>
		<div class="cards">
			{featured.map((item) => (
				<a class="card" href={`/work/${item.id}`}>
					<span class="category">{item.data.category.replace('-', ' ')}</span>
					<h3>{item.data.title}</h3>
					<p>{item.data.summary}</p>
				</a>
			))}
		</div>
		<a class="see-all" href="/work">See all work →</a>
	</section>
</Layout>

<style>
	.hero {
		padding: 3rem 0 2rem;
	}
	.hero h1 {
		margin-bottom: 0.25rem;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
		margin: 1.5rem 0;
	}
	.card {
		display: block;
		border: 1px solid rgba(0, 0, 0, 0.12);
		border-radius: 12px;
		padding: 1.25rem;
		text-decoration: none;
		color: inherit;
	}
	.category {
		font-size: 0.75rem;
		text-transform: uppercase;
		opacity: 0.6;
	}
	.see-all {
		color: inherit;
	}
</style>
