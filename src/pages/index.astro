---
import Layout from '../layouts/Layout.astro';
import GalleryHero from '../components/GalleryHero.astro';
import Museum from '../components/Museum.astro';
import SkillsWall from '../components/SkillsWall.astro';

const rooms = [
	{
		eyebrow: 'Work Experience',
		label: 'Adfactors PR',
		caption: 'Agency pitches and a live retainer — NextOffice, YÊU Cosmetics, and a full year with PNB Housing Finance.',
		href: '/work',
		stat: { value: '171', label: 'pitch & retainer slides across 3 named accounts' },
	},
	{
		eyebrow: 'Case Competitions',
		label: 'The Briefs',
		caption: 'Telecom, FMCG, luxury beauty, mobility, dermatology, and B2B distribution — strategy under six different constraints.',
		href: '/case-competitions',
		stat: { value: '6', label: 'competitions across six industries' },
	},
	{
		eyebrow: 'Mocks',
		label: 'Solo Submissions',
		caption: "Campus wellness tech and a banned brand's re-entry — built solo for HUL's SIP case track.",
		href: '/mocks',
		stat: { value: '2', label: 'independent case submissions' },
	},
	{
		eyebrow: 'Reference',
		label: 'Skills & Strategy Wall',
		caption: 'The methodology, frameworks, and craft that repeat across every room in this gallery.',
		href: '#skills-wall',
	},
];
---

<Layout title="Shubhangi Goyal — Marketer / Strategist / Creative" bleed>
	<GalleryHero
		headline="I collect ideas."
		subhead="see what I've made of them."
		name="Shubhangi Goyal"
		roles={['Marketer', 'Strategist', 'Creative']}
	/>

	<Museum rooms={rooms} />

	<SkillsWall />
</Layout>
