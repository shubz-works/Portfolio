---
import Layout from '../layouts/Layout.astro';
import CardFan from '../components/CardFan.astro';

const cards = [
	{ label: 'Case Studies', href: '/work#case-study' },
	{ label: 'Client Work', href: '/work#client-work' },
	{ label: 'Personal Work', href: '/work#personal-work' },
	{ label: 'Brand Teardowns', href: '/work#brand-teardown' },
	{ label: 'About Me', href: '/about' },
];
---

<Layout title="Your Name">
	<section class="hero">
		<h1>Your Name</h1>
		<p>MBA @ IIM Kozhikode · ex-agency PR &amp; Marketing → General Management &amp; Brand roles</p>
	</section>

	<section class="featured">
		<CardFan cards={cards} />
		<p class="hint">pick a card, any card.</p>
	</section>
</Layout>

<style>
	.hero {
		padding: 3rem 0 2rem;
	}
	.hero h1 {
		margin-bottom: 0.25rem;
	}
	.hint {
		text-align: center;
		font-style: italic;
		opacity: 0.6;
		margin-top: -1rem;
	}
</style>
